; The vector table: reset, then one entry per vector pointing into the
; RAM jump table at 0xFFDC00 (filled from the table in jmptbl.src).
          .CPU        2000A:24
          .IMPORT     _boot_reset
          .SECTION    VECT,DATA,ALIGN=2
          .DATA.L     _boot_reset
RAMTBL:   .EQU        H'FFDC00
          .DATA.L     RAMTBL+4
          .DATA.L     RAMTBL+8
          .DATA.L     RAMTBL+12
          .DATA.L     RAMTBL+16
          .DATA.L     RAMTBL+20
          .DATA.L     RAMTBL+24
