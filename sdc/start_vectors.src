; start_vectors.src: vector table of the application (boot_start_app and start_init set VBR to
; it). Reset goes to start_reset, everything unused to isr_unused. Placed by its own START;
; start.c follows directly.

          .SECTION VECT,DATA,ALIGN=4
          .EXPORT  _start_vectors
          .IMPORT  _start_reset
          .IMPORT  _isr_irq0
          .IMPORT  _isr_irq1
          .IMPORT  _isr_irq2
          .IMPORT  _isr_irq3
          .IMPORT  _isr_tgia_0
          .IMPORT  _isr_tgib_0
          .IMPORT  _isr_tgia_1
          .IMPORT  _isr_tgia_2
          .IMPORT  _isr_tgia_3
          .IMPORT  _isr_tgia_4
          .IMPORT  _isr_cmi1
          .IMPORT  _isr_eri_1
          .IMPORT  _isr_rxi_1
          .IMPORT  _isr_tei_1
          .IMPORT  _isr_txi_1
          .IMPORT  _isr_general_illegal
          .IMPORT  _isr_slot_illegal
          .IMPORT  _isr_address_error
          .IMPORT  _isr_dma_address_error
          .IMPORT  _isr_nmi
          .IMPORT  _isr_user_break
          .IMPORT  _isr_unused

_start_vectors:
          .DATA.L  _start_reset        ; 0: power-on reset PC
          .DATA.L  H'00000000       ; 1: power-on reset SP
          .DATA.L  _start_reset        ; 2: manual reset PC
          .DATA.L  H'00000000       ; 3: manual reset SP
          .DATA.L  _isr_general_illegal        ; 4: general illegal instruction
          .DATA.L  H'00000000       ; 5: reserved
          .DATA.L  _isr_slot_illegal        ; 6: slot illegal instruction
          .DATAB.L 2,H'00000000    ; 7-8: reserved
          .DATA.L  _isr_address_error        ; 9: CPU address error
          .DATA.L  _isr_dma_address_error        ; 10: DMAC/DTC address error
          .DATA.L  _isr_nmi        ; 11: NMI
          .DATA.L  _isr_user_break        ; 12: user break
          .DATA.L  H'00000000       ; 13: reserved
          .DATAB.L 50,_isr_unused     ; 14-63: H-UDI, reserved, TRAPA
          .DATA.L  _isr_irq0        ; 64: IRQ0
          .DATA.L  _isr_irq1        ; 65: IRQ1
          .DATA.L  _isr_irq2        ; 66: IRQ2
          .DATA.L  _isr_irq3        ; 67: IRQ3
          .DATAB.L 20,_isr_unused     ; 68-87: IRQ4, IRQ5, IRQ6, IRQ7, on-chip peripheral
          .DATA.L  _isr_tgia_0        ; 88: on-chip peripheral
          .DATA.L  _isr_tgib_0        ; 89: on-chip peripheral
          .DATAB.L 6,_isr_unused     ; 90-95: on-chip peripheral
          .DATA.L  _isr_tgia_1        ; 96: on-chip peripheral
          .DATAB.L 7,_isr_unused     ; 97-103: on-chip peripheral
          .DATA.L  _isr_tgia_2        ; 104: on-chip peripheral
          .DATAB.L 7,_isr_unused     ; 105-111: on-chip peripheral
          .DATA.L  _isr_tgia_3        ; 112: on-chip peripheral
          .DATAB.L 7,_isr_unused     ; 113-119: on-chip peripheral
          .DATA.L  _isr_tgia_4        ; 120: on-chip peripheral
          .DATAB.L 11,_isr_unused     ; 121-131: on-chip peripheral
          .DATA.L  _isr_eri_1        ; 132: on-chip peripheral
          .DATA.L  _isr_rxi_1        ; 133: on-chip peripheral
          .DATA.L  _isr_txi_1        ; 134: on-chip peripheral
          .DATA.L  _isr_tei_1        ; 135: on-chip peripheral
          .DATAB.L 12,_isr_unused     ; 136-147: on-chip peripheral
          .DATA.L  _isr_cmi1        ; 148: on-chip peripheral
          .DATAB.L 107,_isr_unused     ; 149-255: on-chip peripheral
          .END
