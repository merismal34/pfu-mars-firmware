          .SECTION P,CODE,ALIGN=4
          .EXPORT  __modls
          .IMPORT  __errno
__modls:
          TST      R0,R0
          MOV.L    R2,@-R15
          BT       modls_zero
          MOV.L    R3,@-R15
          MOV      #0,R2
          MOV.L    R4,@-R15
          DIV0S    R2,R1
          MOVT     R4
          SUBC     R3,R3
          SUBC     R2,R1
          DIV0S    R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          ROTCL    R1
          DIV1     R0,R3
          DIV0S    R2,R3
          MOVT     R2
          XOR      R4,R2
          ROTCR    R2
          BF       modls_L
          DIV0S    R0,R3
          SHAR     R3
          DIV1     R0,R3
modls_L:
          ADD      R4,R3
          MOV      R3,R0
          MOV.L    @R15+,R4
          MOV.L    @R15+,R3
          RTS
          MOV.L    @R15+,R2
modls_zero:
          MOV.L    A_errno,R1
          MOV.L    n_zerono,R2
          MOV      #0,R0
          MOV.L    R2,@R1
          RTS
          MOV.L    @R15+,R2
          .DATA.W  H'0009   ; nop
A_errno:
          .DATA.L  __errno
n_zerono:
          .DATA.L  H'0000044E
          .END
