          .SECTION P,CODE,ALIGN=4
          .EXPORT  __in_sqrtd
exception1:
          TST      R2,R2
          BF       return_NaN
          TST      R3,R3
          BF       return_NaN
          BRA      return_inf
          NOP
return_zero:
          MOV.L    ZERO,R4
          EXTU.W   R4,R4
          SHLL     R4
          SHLL     R5
          ROTCR    R4
          MOV      #0,R1
          BRA      return_value1
          MOV      #0,R0
return_inf:
          MOV.L    INF,R4
          MOV      #0,R1
          BRA      return_value
          MOV      #0,R0
return_NaN:
          MOV.L    INF,R4
          MOV      #-1,R1
          BRA      return_value
          MOV      #-1,R0
__in_sqrtd:
          MOV.L    R8,@-R15
          MOV.L    R9,@-R15
          MOV.L    R10,@-R15
          MOV.L    R11,@-R15
          MOV.L    R12,@-R15
          MOV.L    @(24,R15),R5
          EXTS.W   R5,R4
          MOV.L    @(28,R15),R2
          MOV.L    @(32,R15),R3
          MOV.L    ZERO,R6
          CMP/GE   R4,R6
          BT       return_zero
          SHLL     R5
          BT       return_NaN
          MOV.L    INF,R6
          CMP/GE   R6,R4
          BT       exception1
          MOV      #0,R6
          MOV      #0,R7
          MOV      #0,R1
          MOV      #0,R0
          MOV      #0,R11
          MOV      #0,R12
          MOV      #0,R8
          MOV      #1,R9
          MOV      #61,R10
          SHLR     R4
          BF       end_calc_exp
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
end_calc_exp:
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          SETT
mantissa_loop:
          ROTCL    R12
          ROTCL    R11
          CMP/HI   R11,R6
          BT       LSB_1
          CMP/HS   R11,R6
          BF       LSB_0
          CMP/HS   R12,R7
          BF       LSB_0
LSB_1:
          ROTCL    R0
          ROTCL    R1
          SUBC     R12,R7
          SUBC     R11,R6
          ADDC     R9,R12
          BRA      check_loop
          ADDC     R8,R11
LSB_0:
          XOR      R9,R12
          ROTCL    R0
          ROTCL    R1
check_loop:
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          ADD      #-1,R10
          CMP/PL   R10
          BT       mantissa_loop
          MOV      #0,R10
          MOV      #0,R5
          SETT
          ROTCL    R12
          ROTCL    R11
          CMP/HI   R11,R6
          BT       LSB_1_1
          CMP/HS   R11,R6
          BF       LSB_0_1
          CMP/HS   R12,R7
          BF       LSB_0_1
LSB_1_1:
          ROTCL    R0
          ROTCL    R1
          SUBC     R12,R7
          SUBC     R11,R6
          ADDC     R9,R12
          BRA      loop1
          ADDC     R8,R11
LSB_0_1:
          XOR      R9,R12
          ROTCL    R0
          ROTCL    R1
loop1:
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          ROTCL    R10
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          ROTCL    R10
          SETT
          ROTCL    R12
          ROTCL    R11
          ROTCL    R5
          CMP/HI   R5,R10
          BT       LSB_1_2
          CMP/HS   R5,R10
          BF       LSB_0_2
          CMP/HI   R11,R6
          BT       LSB_1_2
          CMP/HS   R11,R6
          BF       LSB_0_2
          CMP/HS   R12,R7
          BF       LSB_0_2
LSB_1_2:
          ROTCL    R0
          ROTCL    R1
          SUBC     R12,R7
          SUBC     R11,R6
          BRA      loop2
          SUBC     R5,R10
LSB_0_2:
          ROTCL    R0
          ROTCL    R1
loop2:
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          ROTCL    R10
          SHLL     R3
          ROTCL    R2
          ROTCL    R7
          ROTCL    R6
          ROTCL    R10
          SHLL     R0
          ROTCL    R1
          TST      R10,R10
          BF       setsticky
          TST      R6,R6
          BF       setsticky
          TST      R7,R7
          BT       return_value
setsticky:
          OR       #1,R0
return_value:
end_calc_mantissa:
          EXTU.W   R4,R4
return_value1:
          MOV.L    @(20,R15),R6
          MOV.L    R4,@R6
          MOV.L    R1,@(4,R6)
          MOV.L    R0,@(8,R6)
          MOV.L    @R15+,R12
          MOV.L    @R15+,R11
          MOV.L    @R15+,R10
          MOV.L    @R15+,R9
          RTS
          MOV.L    @R15+,R8
          .DATA.W  H'0009   ; nop
INF:
          .DATA.L  H'00007FFF
ZERO:
          .DATA.L  H'FFFF8001
          .END
