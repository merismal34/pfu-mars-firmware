          .SECTION P,CODE,ALIGN=4
          .EXPORT  __addd
          .EXPORT  __subd
          .EXPORT  __subdr
__subd:
          MOV.L    R0,@-R15
          MOV.L    R4,@-R15
          MOV.L    R5,@-R15
          MOV.L    R6,@-R15
          MOV.L    R7,@-R15
          MOV.L    @(24,R15),R4
          MOV.L    @(28,R15),R5
          MOV.L    @(32,R15),R6
          MOV.L    @(36,R15),R7
          MOV.L    SIGN,R0
          BRA      sub_in
          XOR      R0,R6
__subdr:
          MOV.L    R0,@-R15
          MOV.L    R4,@-R15
          MOV.L    R5,@-R15
          MOV.L    R6,@-R15
          MOV.L    R7,@-R15
          MOV.L    @(24,R15),R6
          MOV.L    @(28,R15),R7
          MOV.L    @(32,R15),R4
          MOV.L    @(36,R15),R5
          MOV.L    SIGN,R0
          BRA      sub_in
          XOR      R0,R6
exception1:
          TST      R4,R4
          BF       return_NaN
          TST      R5,R5
          BF       return_NaN
          CMP/EQ   R3,R9
          BF       return_inf
          TST      R7,R7
          BF       return_NaN
          DIV0S    R10,R11
          BF       return_inf
return_NaN:
          MOV      #0,R10
          MOV      #0,R4
          BRA      return_value
          MOV      #8,R5
return_inf:
          BRA      return_value
          NOP
exception2:
          TST      R8,R8
          BF       p2_denorm_check
          TST      R4,R4
          BF       p1_denorm
          TST      R5,R5
          BF       p1_denorm
          TST      R7,R7
          BF       return_p2
          BRA      return_value
          AND      R11,R10
p2_denorm_check:
          TST      R6,R6
          BF       p2_normalize
          TST      R7,R7
          BF       p2_normalize
          BRA      return_p1
          NOP
p1_denorm:
          TST      R6,R6
          BF       p1_normalize
          TST      R7,R7
          BF       p1_normalize
          BRA      return_p1
          NOP
return_p2:
          MOV      R6,R4
          MOV      R7,R5
          MOV      R9,R8
          MOV      R11,R10
return_p1:
          SHLL     R5
          ROTCL    R4
          SHLL     R5
          ROTCL    R4
          SHLL     R5
          BRA      return_value
          ROTCL    R4
p1_normalize:
          MOV.L    NORMAL,R3
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BT       p2_normalize
p1_norm_loop:
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BF/S     p1_norm_loop
          ADD      #-1,R8
p2_normalize:
end_p1_norm:
          MOV.L    NORMAL,R3
          SHLL     R7
          ROTCL    R6
          CMP/GE   R3,R6
          BT       end_p2_norm
p2_norm_loop:
          SHLL     R7
          ROTCL    R6
          CMP/GE   R3,R6
          BF/S     p2_norm_loop
          ADD      #-1,R9
end_p2_norm:
          CMP/GT   R8,R9
          BF       swap_end
          BRA      swap
          NOP
swap_end:
          BRA      exception_return
          NOP
return_zero:
          MOV      #0,R8
          MOV      #0,R4
          BRA      return_value
          MOV      #0,R5
          .DATA.W  H'0009   ; nop
__addd:
          MOV.L    R0,@-R15
          MOV.L    R4,@-R15
          MOV.L    R5,@-R15
          MOV.L    R6,@-R15
          MOV.L    R7,@-R15
          MOV.L    @(24,R15),R4
          MOV.L    @(28,R15),R5
          MOV.L    @(32,R15),R6
          MOV.L    @(36,R15),R7
sub_in:
          MOV.L    R2,@-R15
          MOV.L    R3,@-R15
          MOV.L    R8,@-R15
          MOV.L    R9,@-R15
          MOV.L    R10,@-R15
          MOV.L    R11,@-R15
          ROTL     R4
          ROTL     R6
          CMP/HS   R6,R4
          BT       rotation
          MOV      R4,R2
          MOV      R6,R4
          MOV      R2,R6
          MOV      R5,R2
          MOV      R7,R5
          MOV      R2,R7
rotation:
          ROTR     R4
          ROTR     R6
          MOV.L    EXP_INF,R3
          MOV.L    MMASK,R0
          MOV      R4,R10
          MOV      R6,R11
          MOV      R4,R8
          SHLR16   R8
          SHLR2    R8
          SHLR2    R8
          AND      R3,R8
          MOV      R6,R9
          SHLR16   R9
          SHLR2    R9
          SHLR2    R9
          AND      R3,R9
          AND      R0,R4
          AND      R0,R6
          CMP/EQ   R3,R8
          BT       exception1
          TST      R9,R9
          BT       exception2
exception_return:
          SHLL     R5
          ROTCL    R4
          SHLL     R5
          ROTCL    R4
          SHLL     R5
          ROTCL    R4
          SHLL     R7
          ROTCL    R6
          SHLL     R7
          ROTCL    R6
          SHLL     R7
          ROTCL    R6
          MOV.L    MSB,R0
          OR       R0,R4
          OR       R0,R6
          MOV      R8,R2
          SUB      R9,R2
          TST      R2,R2
          BT       end_sftr
          MOV      #3,R3
          CMP/GE   R2,R3
          BT       sftr_loop
          MOV      #54,R3
          CMP/GT   R3,R2
          BT       e_sftr55
          MOV      #32,R3
          CMP/GT   R3,R2
          BF/S     e_sftr31
          MOV      #1,R9
          SUB      R3,R2
          TST      R7,R7
          BT       sftr1
          OR       R9,R6
sftr1:
          MOV      R6,R7
          MOV      #0,R6
e_sftr31:
          STS.L    MACH,@-R15
          MOVA     sftrtbl,R0
          STS.L    MACL,@-R15
          SHLL2    R2
          ADD      R2,R0
          MOV.L    @R0,R0
          DMULU.L  R0,R7
          STS      MACH,R7
          STS      MACL,R2
          DMULU.L  R0,R6
          STS      MACH,R6
          STS      MACL,R3
          LDS.L    @R15+,MACL
          TST      R2,R2
          LDS.L    @R15+,MACH
          BT/S     end_sftr
          OR       R3,R7
          BRA      end_sftr
          OR       R9,R7
e_sftr55:
          MOV      #0,R6
          BRA      end_sftr
          MOV      #1,R7
sftr_loop:
          SHLR     R6
          ROTCR    R7
          DT       R2
          BF       sftr_loop
end_sftr:
          DIV0S    R10,R11
          BT       mantissa_sub
          ADDC     R7,R5
          ADDC     R6,R4
          MOV.L    CARRY_CHECK,R3
          CMP/GT   R4,R3
          BT       end_norm
          SHLR     R4
          ROTCR    R5
          MOVT     R2
          OR       R2,R5
          ADD      #1,R8
          MOV.L    EXP_INF,R3
          CMP/EQ   R3,R8
          BF       end_norm
          MOV      #0,R5
          BRA      return_value
          MOV      #0,R4
mantissa_sub:
          CMP/EQ   R4,R6
          BF       man_sub1
          CMP/EQ   R5,R7
          BT       plus_zero
man_sub1:
          SUBC     R7,R5
          SUBC     R6,R4
          BF       normalize
          CLRT
          NEGC     R5,R5
          NEGC     R4,R4
          MOV      R11,R10
normalize:
          TST      R4,R4
          BF       norm32_end
          MOV      R5,R4
          MOV      #0,R5
          ADD      #-32,R8
norm32_end:
          MOV.L    HALF,R3
          TST      R4,R3
          BF       norm16_end
          MOV      R5,R3
          XTRCT    R4,R3
          MOV      R3,R4
          SHLL16   R5
          ADD      #-16,R8
norm16_end:
          MOV.L    CARRY_CHECK,R3
          CMP/HI   R4,R3
          BT       overnorm_end
over_norm:
          SHLR     R4
          ROTCR    R5
          CMP/HI   R4,R3
          BT/S     end_norm
          ADD      #1,R8
          SHLR     R4
          ROTCR    R5
          CMP/HI   R4,R3
          BT/S     end_norm
          ADD      #1,R8
          SHLR     R4
          ROTCR    R5
          CMP/HI   R4,R3
          BT/S     end_norm
          ADD      #1,R8
          SHLR     R4
          ROTCR    R5
          CMP/HI   R4,R3
          BT/S     end_norm
          ADD      #1,R8
          BRA      over_norm
          NOP
overnorm_end:
          MOV.L    MSB,R3
          CMP/GE   R3,R4
          BT       end_norm
norm_loop:
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BT/S     end_norm
          ADD      #-1,R8
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BT/S     end_norm
          ADD      #-1,R8
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BT/S     end_norm
          ADD      #-1,R8
          SHLL     R5
          ROTCL    R4
          CMP/GE   R3,R4
          BF/S     norm_loop
          ADD      #-1,R8
end_norm:
end_calc:
          CMP/PL   R8
          BT       end_denormal
          NEG      R8,R8
          ADD      #1,R8
denormalize_loop:
          SHLR     R4
          ROTCR    R5
          DT       R8
          BF       denormalize_loop
end_denormal:
round:
          MOV      R5,R0
          TST      #4,R0
          BT       return_value
          TST      #11,R0
          BT       return_value
          MOV      #8,R0
          ADDC     R0,R5
          MOV      #0,R0
          ADDC     R0,R4
          MOV.L    CARRY_CHECK,R0
          CMP/GT   R4,R0
          BT       return_value
round_carry:
          SHLR     R4
          ROTCR    R5
          ADD      #1,R8
return_value:
end_round:
          SHLR     R4
          ROTCR    R5
          SHLR     R4
          ROTCR    R5
          SHLR     R4
          ROTCR    R5
          MOV.L    MMASK,R0
          AND      R0,R4
          SHLL16   R8
          SHLL2    R8
          SHLL2    R8
          OR       R8,R4
          SHLL     R4
          SHLL     R10
          ROTCR    R4
return:
          MOV.L    @R15+,R11
          MOV.L    @R15+,R10
          MOV.L    @R15+,R9
          MOV.L    @R15+,R8
          MOV.L    @R15+,R3
          MOV.L    @R15+,R2
          MOV.L    @(20,R15),R6
          MOV.L    R4,@R6
          MOV.L    R5,@(4,R6)
          MOV.L    @R15+,R7
          MOV.L    @R15+,R6
          MOV.L    @R15+,R5
          MOV.L    @R15+,R4
          MOV.L    @R15+,R0
          RTS
          ADD      #20,R15
plus_zero:
          MOV      #0,R10
          MOV      #0,R8
          MOV      #0,R4
          BRA      return_value
          MOV      #0,R5
swap:
          XOR      R10,R11
          XOR      R11,R10
          XOR      R10,R11
          XOR      R8,R9
          XOR      R9,R8
          XOR      R8,R9
          XOR      R4,R6
          XOR      R6,R4
          XOR      R4,R6
          XOR      R5,R7
          XOR      R7,R5
          BRA      swap_end
          XOR      R5,R7
EXP_INF:
          .DATA.L  H'000007FF
MMASK:
          .DATA.L  H'000FFFFF
MSB:
          .DATA.L  H'00800000
LOWMASK:
          .DATA.W  H'0000
          .DATA.W  H'FFFF
CARRY_CHECK:
          .DATA.L  H'01000000
NORMAL:
          .DATA.L  H'00100000
SIGN:
          .DATA.L  H'80000000
HALF:
          .DATA.L  H'FFFF0000
sftrtbl:
          .DATA.L  H'00000000
          .DATA.L  H'80000000
          .DATA.L  H'40000000
          .DATA.L  H'20000000
          .DATA.L  H'10000000
          .DATA.L  H'08000000
          .DATA.L  H'04000000
          .DATA.L  H'02000000
          .DATA.L  H'01000000
          .DATA.L  H'00800000
          .DATA.L  H'00400000
          .DATA.L  H'00200000
          .DATA.L  H'00100000
          .DATA.L  H'00080000
          .DATA.L  H'00040000
          .DATA.L  H'00020000
          .DATA.L  H'00010000
          .DATA.L  H'00008000
          .DATA.L  H'00004000
          .DATA.L  H'00002000
          .DATA.L  H'00001000
          .DATA.L  H'00000800
          .DATA.L  H'00000400
          .DATA.L  H'00000200
          .DATA.L  H'00000100
          .DATA.L  H'00000080
          .DATA.L  H'00000040
          .DATA.L  H'00000020
          .DATA.L  H'00000010
          .DATA.L  H'00000008
          .DATA.L  H'00000004
          .DATA.L  H'00000002
          .DATA.L  H'00000001
          .END
