          .SECTION P,CODE,ALIGN=4
          .EXPORT  __bfswu
__bfswu:
          MOV.L    R1,@-R15
          MOV.L    R3,@-R15
          SWAP.B   R1,R3
          EXTU.B   R1,R1
          MOV.L    R4,@-R15
          EXTU.B   R3,R3
          MOV.L    R5,@-R15
          MOV      R1,R4
          MOV.L    R6,@-R15
          MOV      #0,R5
          MOV      #-1,R6
bfswu_L1:
          SHLL     R5
          SHLL     R6
          ADD      #-1,R4
          ADD      #1,R5
          CMP/PL   R4
          BF       bfswu_L11
          SHLL     R5
          SHLL     R6
          ADD      #-1,R4
          ADD      #1,R5
          CMP/PL   R4
          BT       bfswu_L1
bfswu_L11:
          AND      R5,R0
          MOV      #16,R4
          SUB      R1,R4
          SUB      R3,R4
          MOV      R0,R5
          TST      R4,R4
          BT       bfswu_L5
bfswu_L4:
          SHLL     R6
          SHLL     R5
          ADD      #-1,R4
          ADD      #1,R6
          CMP/PL   R4
          BF       bfswu_L5
          SHLL     R6
          SHLL     R5
          ADD      #-1,R4
          ADD      #1,R6
          CMP/PL   R4
          BT       bfswu_L4
bfswu_L5:
          MOV.W    @R2,R4
          AND      R4,R6
          OR       R6,R5
          MOV.W    R5,@R2
          MOV.L    @R15+,R6
          MOV.L    @R15+,R5
          MOV.L    @R15+,R4
bfswu_end1:
          MOV.L    @R15+,R3
          RTS
          MOV.L    @R15+,R1
          .END
